# Configuración de los tests que NO usan la base (npm test).
# DB_PORT=1: nadie escucha ahí, así que la conexión falla enseguida y ningún test
# depende de la base ni del .env de cada desarrollador. No contiene secretos reales.
NODE_ENV=testing
PORT=3999
DB_HOST=127.0.0.1
DB_PORT=1
DB_NAME=podjud_licencias
DB_USER=licencias_app
DB_PASS=sin-clave
JWT_SECRET=clave-de-prueba-solo-para-tests-0123456789abcdef
SESION_COOKIE_SECURE=false
SMTP_HOST=
API_DOCS_PASSWORD_HASH=
CARGA_MASIVA=off
AVISO_REPETIDA=off
